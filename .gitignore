# Ignore all files in the Disketten directory
Disketten/
examples/
build/*
cparun/build/*
!build/.gitkeep
16bitTest/build/*
!16bitTest/build/.gitkeep
16bitTest/z8001/*.bin
16bitTest/z8001/*.inc
# Ignore configuration files they are generated by menuconfig
.config
.config.old
.config.bak

# Ignore windows tools
/tools/python3
/tools/greaseweazle
/tools/make
/tools/PortableGit

# Ignore Python virtual environment
.venv/

# Ignore Python bytecode cache
__pycache__/

# Ignore VSCode settings
.vscode/*
