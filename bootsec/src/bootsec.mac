; ======================================================================
; GOCPM: CP/M-Kaltstart-Initialisierung (1090H-10B1H)
; ======================================================================
; Patcht Warmstart-JP bei 0000H, BDOS-JP bei 0005H,
; setzt DMA auf 0080H und springt zum CCP.
; (Disassembliert aus Binaerdaten)
	LD	A,0C3H		; 1090
	LD	(0000H),A		; 1092
