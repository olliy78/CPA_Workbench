	TITLE	'EM256 U8000 16-Bit CPU Test'
	.Z80
;
; em256test.mac - Testprogramm fuer die EM256 16-Bit-Erweiterungskarte
;                 des BC A5120 Buerocomputers
;
; Zweck:
;   1. Z8000-Maschinencode in den EM256-Speicher laden
;      (einfache Addition: 0x1234 + 0x5678 = 0x68AC, Ergebnis im Shared-RAM)
;   2. U8000 starten (Reset aufheben)
;   3. Auf Fertigmeldung des U8000 warten (Transfer Enable / Timeout)
;   4. Ergebnis aus Shared-RAM lesen und pruefen
;   5. Alle Schritte als CP/M-Konsolenausgabe protokollieren
;
; Assemblierung:
;   m80  em256test.erl=em256test
;   linkmt em256test=em256test/p:100
;   (erzeugt em256test.com fuer CP/M / CP/A)
;
; Autor:  (c) 2026 Olaf Krieger
; Lizenz: MIT
; Datum:  2026-04-06
;

; =============================================================================
; CP/M BDOS-Konstanten
; =============================================================================
BDOS	EQU	0005H		; BDOS-Einsprungadresse (CP/M-Standard)
CONOUT	EQU	2		; BDOS-Funktion: Zeichen auf Konsole ausgeben (C=Zeichen)
PRINT	EQU	9		; BDOS-Funktion: String ausgeben (DE=Adresse, '$'-terminiert)
STACK	EQU	0100H		; Stapel ganz oben im TPA (wir nutzen CP/M-Standard-Stack)

; =============================================================================
; EM256-Hardware-Konstanten
; (aus src/bc_a5120/bios.mac und src/bc_a5120/biosremc.mac)
; =============================================================================
MODADR	EQU	0A8H		; PIO Port B Datenadresse (Steuerregister U8000 + RAM)
PIOA	EQU	0A8H		; PIO Port A Datenadresse (Status U8000, alle Eingabe)
PIOB	EQU	0A9H		; PIO Port B Datenadresse (Steuer, Ausgabe)
PIOACTRL EQU	0AAH		; PIO Port A Steuerregister
PIOBCTRL EQU	0ABH		; PIO Port B Steuerregister
RAM16	EQU	0AFH		; 16*4-RAM Page/Write-Register (Subadresse in Portadr.-Bits 7:4)
EM256ADR EQU	4000H		; Z80-Fensteradresse des eingeblendeten 256K-RAM

; PIO Port B Bit-Positionen (Ausgabe)
SG0P	EQU	0		; Segment-Bit 0 fuer U880-Zugriff
SG1B	EQU	1		; Segment-Bit 1 fuer U880-Zugriff
N_RAMEN	EQU	2		; RAM-Enable (negiert: 0=ein)
N_STOP	EQU	3		; U8000-Stop (negiert: 0=gestoppt, 1=laeuft)
RESET16	EQU	4		; U8000-Reset (1=in Reset gehalten)
N_TRQ8	EQU	5		; Transfer-Request U880->U8000 (negiert: 0=aktiv)
PRRESET	EQU	6		; Paritaetsfehler-Latch-Reset

; PIO Port A Bit-Positionen (Eingabe)
INT16	EQU	4		; Interrupt U8000->U880 (1=Interrupt angemeldet)
TREN	EQU	7		; Transfer Enable (1=U8000 bereit)

; 16*4-RAM Register Bits (MODADR+7, Bits im Datenbyte)
N_PAGEN	EQU	0		; Page enable (negiert: 0=eingeblendet)
N_WRITE	EQU	1		; Write enable (negiert: 0=schreibbar)

; Erwartetes Ergebnis der Z8000-Addition
EXPECTED_LO	EQU	0ACH	; Low-Byte von 0x68AC (0x1234 + 0x5678)
EXPECTED_HI	EQU	068H	; High-Byte von 0x68AC

; Timeout-Zaehler (Schleifeniteratoren, ca. 2 Sekunden auf ~4 MHz Z80)
TIMEOUT_HI	EQU	020H	; ~8192 aeussere Schleifendurchlaeufe
TIMEOUT_LO	EQU	000H	; 256 innere Durchlaeufe

; =============================================================================
; Programmstart - CP/M .COM-Format: Ausfuehrung beginnt bei 0x100
; =============================================================================
	ORG	100H

START:
	; CP/M-Stack sichern, eigenen Stack aufsetzen
	LD	(SAVED_SP), SP
	LD	SP, STACK_TOP

	; === Schritt 1: Gruss ===
	LD	DE, MSG_BANNER
	CALL	PUTS

	; === Schritt 2: PIO initialisieren ===
	LD	DE, MSG_INIT
	CALL	PUTS
	CALL	INIT_PIO

	; === Schritt 3: EM256 vorhanden? ===
	LD	DE, MSG_DETECT
	CALL	PUTS
	CALL	DETECT_EM256
	JR	NC, STEP4		; Carry clear = gefunden
	LD	DE, MSG_NOT_FOUND
	CALL	PUTS
	JP	EXIT

STEP4:
	LD	DE, MSG_FOUND
	CALL	PUTS

	; === Schritt 4: Z8000-Code in Shared-RAM laden ===
	LD	DE, MSG_LOAD
	CALL	PUTS
	CALL	LOAD_Z8000_CODE

	; === Schritt 5: U8000 starten ===
	LD	DE, MSG_START
	CALL	PUTS
	CALL	START_U8000

	; === Schritt 6: Auf Fertigmeldung warten ===
	LD	DE, MSG_WAIT
	CALL	PUTS
	CALL	WAIT_READY
	JR	NC, STEP7		; Carry clear = bereit
	LD	DE, MSG_TIMEOUT
	CALL	PUTS
	CALL	STOP_U8000
	JP	EXIT

STEP7:
	LD	DE, MSG_READY
	CALL	PUTS

	; === Schritt 7: U8000 anhalten ===
	CALL	STOP_U8000

	; === Schritt 8: Ergebnis aus Shared-RAM lesen ===
	LD	DE, MSG_READ
	CALL	PUTS
	CALL	READ_RESULT

	; === Schritt 9: Ergebnis pruefen ===
	LD	DE, MSG_CHECK
	CALL	PUTS
	CALL	CHECK_RESULT
	JR	NC, PASS

	; Fehler
	LD	DE, MSG_FAIL
	CALL	PUTS
	JP	EXIT

PASS:
	LD	DE, MSG_OK
	CALL	PUTS

EXIT:
	LD	DE, MSG_DONE
	CALL	PUTS
	LD	SP, (SAVED_SP)
	RET			; Rueckkehr zu CP/M

; =============================================================================
; INIT_PIO - PIO der EM256 initialisieren
;
; Setzt PIO Port A (alle Eingabe) und PIO Port B (b7 Eingabe, Rest Ausgabe).
; U8000 wird in Reset gehalten, RAM deaktiviert.
; Paritaetsfehler-Latch wird zurueckgesetzt.
;
; WICHTIG: PIO-Steuerregister muessen via OTIR (OUT (C),r mit B:C als Port-
;   adresse) beschrieben werden, NICHT via OUT (n),A!
;   OUT (n),A legt den Akkumulator-Inhalt auf die oberen Adressleitungen
;   (A8-A15). Die EM256-Karte dekodiert diese Leitungen fuer das 16*4-RAM-
;   Register. Der Adressdekoder laesst PIO-Zugriffe mit grossen oberen
;   Adressbytes (z.B. 0xCF bei OUT (0ABh),A mit A=0CFh) moeglicherweise
;   NICHT durch -> PIO-Initialisierung geht verloren!
;   OTIR erzeugt kleine obere Bytes (B zaehlt von 3/5 herunter), genau
;   wie das BIOS es macht (biosremc.mac: emina).
;
; Aendert: A, BC, HL
; =============================================================================
INIT_PIO:
	; --- PIO Port A initialisieren (via OTIR, wie BIOS) ---
	LD	B, 3
	LD	HL, PA_INIT	; 3 Bytes: 0CFh, 0FFh, 07h
	LD	C, PIOACTRL	; C = 0xAA
	OTIR

	; --- PIO Port B initialisieren (via OTIR, wie BIOS) ---
	LD	B, 3
	LD	HL, PB_INIT	; 3 Bytes: 0CFh, 80h, 07h
	LD	C, PIOBCTRL	; C = 0xAB
	OTIR

	; --- Ruhezustand: U8000 in Reset, RAM deaktiviert ---
	; Paritaetsfehler-Latch zuruecksetzen (Flanke auf prreset erzeugen)
	LD	A, (1 SHL PRRESET) OR (1 SHL RESET16) OR (1 SHL N_RAMEN)
	OUT	(PIOB), A
	; Latch freigeben
	LD	A, (1 SHL RESET16) OR (1 SHL N_RAMEN)
	OUT	(PIOB), A
	; Alle 16 Steuerpositionen des 16*4-RAM deaktivieren.
	; Portadresse BC: B ist der High-Byte der I/O-Adresse.
	; Datenbyte 0x07: wie BIOS (n_pagen=1, n_write=1, /A14=1, /A15=0)
	; BIOS-Formel: 1 shl n_pagen or 1 shl n_write or hbemadr shr 12
	;   hbemadr = em256adr AND 0C000h = 4000h -> hbemadr shr 12 = 4
	;   Also: 01h | 02h | 04h = 07h
	LD	B, 0		; Start: Port-High-Byte 0x00 (= Fenster 0x0000)
	LD	C, RAM16	; C = 0xAF (fester Port-Low-Byte)
INIT_LOOP:
	LD	A, 07H		; 0x07: Page-disable, Write-disable, /A14=1 (wie BIOS)
	OUT	(C), A		; Position fuer dieses 4KB-Fenster sperren
	LD	A, B
	ADD	A, 010H		; B += 0x10: naechstes 4KB-Fenster
	LD	B, A		; B aktualisieren (LD aendert Flags nicht!)
	JR	NZ, INIT_LOOP	; weiter bis B wieder 0 (nach 16 Iterationen)

	; Finale Sicherung: U8000 in Reset, RAM aus
	LD	A, (1 SHL RESET16) OR (1 SHL N_RAMEN)
	OUT	(PIOB), A
	RET

; PIO-Initialisierungsdaten (identisch mit BIOS painit/pbinit, ohne Vektor)
PA_INIT:
	DB	0CFH		; Bit-E/A-Modus (Mode 3)
	DB	0FFH		; Alle 8 Bits = Eingabe
	DB	07H		; Interrupts verboten
PB_INIT:
	DB	0CFH		; Bit-E/A-Modus (Mode 3)
	DB	80H		; Bit 7 Eingabe (n_pe), Bits 0-6 Ausgabe
	DB	07H		; Interrupts verboten (kein Paritaets-INT)

; =============================================================================
; DETECT_EM256 - Prueft ob eine EM256-Karte vorhanden ist (BIOS-Methode)
;
; Methode (identisch mit CP/A-BIOS biosremc.mac):
;   1. Aktuellen Z80-RAM-Inhalt sichern.
;   2. Z80-RAM an EM256ADR mit 0x0000 ueberschreiben (bekannter Zustand).
;   3. EM256 Seite 0 einblenden (RAMON_S0).
;   4. Muster 0xA55A schreiben und zuruecklesen (Schreib-Test).
;   5. EM256 ausblenden (RAMOFF).
;   6. Z80-RAM lesen:
;      -> 0x0000 : EM256 war aktiv (Schreiben ging in EM256, nicht Z80-RAM) -> OK
;      -> 0xA55A : EM256 war NICHT aktiv (Schreiben ging in Z80-RAM)        -> FEHLER
;
; WICHTIG: Zwischen RAMON_S0 und RAMOFF duerfen KEINE BDOS-Aufrufe erfolgen!
;   Das BIOS/BDOS koennte den PIO-Zustand veraendern (z.B. durch Interrupt-
;   Handler oder interne Routinen), was die EM256-Einblendung rueckgaengig
;   machen wuerde. Das BIOS macht es genauso: die Erkennung in biosremc.mac
;   ist rein atomare Speicheroperationen ohne jede Ausgabe.
;   Diagnose-Werte werden in Variablen gespeichert und NACH RAMOFF ausgegeben.
;
; Rueckgabe: Carry clear = gefunden, Carry set = nicht gefunden
; Aendert:   A, BC, DE, HL
; =============================================================================
DETECT_EM256:
	; --- PIO-B Selbsttest: Schreiben und Zuruecklesen ---
	; Testet ob OUT (PIOB),A ueberhaupt funktioniert
	LD	A, (1 SHL RESET16) OR (1 SHL N_RAMEN)	; 0x14 (Idle-Zustand)
	OUT	(PIOB), A
	IN	A, (PIOB)
	LD	(DBG_PB0), A	; PIO-B nach Idle-Write (sollte 0x94 sein)

	; ===================================================================
	; ATOMARER ABSCHNITT: Kein BDOS-Aufruf bis nach RAMOFF!
	; ===================================================================

	; Schritt 1: Z80-RAM-Inhalt sichern
	LD	HL, (EM256ADR)
	LD	(SAVE_WORD), HL

	; Schritt 2: Z80-RAM mit 0x0000 beschreiben (BIOS-Trick)
	LD	HL, 0
	LD	(EM256ADR), HL

	; Schritt 3: EM256 Seite 0 einblenden
	CALL	RAMON_S0

	; Schritt 4: PIO-B direkt nach RAMON_S0 lesen (Diagnose)
	IN	A, (PIOB)
	LD	(DBG_PB1), A	; PIO-B nach RAMON (sollte 0x90 sein: 0x10|0x80)

	; Schritt 5: Alten EM256-Inhalt lesen (vor Schreiben)
	LD	HL, (EM256ADR)
	LD	(DBG_EM_BEFORE), HL

	; Schritt 6: Muster 0xA55A schreiben
	LD	HL, 0A55AH
	LD	(EM256ADR), HL

	; Schritt 7: Muster zuruecklesen
	LD	HL, (EM256ADR)
	LD	(DBG_READBACK), HL

	; Schritt 8: EM256 ausblenden
	CALL	RAMOFF

	; Schritt 9: PIO-B nach RAMOFF lesen (Diagnose)
	IN	A, (PIOB)
	LD	(DBG_PB2), A	; PIO-B nach RAMOFF (sollte 0x94 sein: 0x14|0x80)

	; Schritt 10: Z80-RAM lesen (der kritische Test!)
	LD	HL, (EM256ADR)
	LD	(DBG_Z80_AFTER), HL

	; Schritt 11: Z80-RAM-Inhalt wiederherstellen
	LD	HL, (SAVE_WORD)
	LD	(EM256ADR), HL

	; ===================================================================
	; ATOMARER ABSCHNITT ENDE - Ab hier Diagnose-Ausgaben
	; ===================================================================

	; --- PIO-B Selbsttest-Ergebnis ---
	LD	DE, MSG_PB_SELF
	CALL	PUTS
	LD	A, (DBG_PB0)
	CALL	PUTHEX
	LD	DE, MSG_CRLF
	CALL	PUTS

	; --- PIO-B nach RAMON_S0 ---
	LD	DE, MSG_PB_RAMON
	CALL	PUTS
	LD	A, (DBG_PB1)
	CALL	PUTHEX
	LD	DE, MSG_CRLF
	CALL	PUTS

	; --- EM256-Inhalt vor Write ---
	LD	DE, MSG_D2
	CALL	PUTS
	LD	A, (DBG_EM_BEFORE+1)
	CALL	PUTHEX
	LD	A, (DBG_EM_BEFORE)
	CALL	PUTHEX
	LD	DE, MSG_CRLF
	CALL	PUTS

	; --- Ruecklesen ---
	LD	DE, MSG_D3
	CALL	PUTS
	LD	A, (DBG_READBACK+1)
	CALL	PUTHEX
	LD	A, (DBG_READBACK)
	CALL	PUTHEX
	LD	DE, MSG_CRLF
	CALL	PUTS

	; Schreib-Test: Kam 0xA55A an?
	LD	HL, (DBG_READBACK)
	LD	DE, 0A55AH
	OR	A
	SBC	HL, DE
	JP	Z, DET_WRITE_OK

	; Write/Read fehlgeschlagen -> kein beschreibbarer RAM
	LD	DE, MSG_D_ERR1
	CALL	PUTS
	SCF
	RET

DET_WRITE_OK:
	LD	DE, MSG_D_OK1
	CALL	PUTS

	; --- PIO-B nach RAMOFF ---
	LD	DE, MSG_PB_RAMOFF
	CALL	PUTS
	LD	A, (DBG_PB2)
	CALL	PUTHEX
	LD	DE, MSG_CRLF
	CALL	PUTS

	; --- Z80-RAM nach RAMOFF ---
	LD	DE, MSG_D4
	CALL	PUTS
	LD	A, (DBG_Z80_AFTER+1)
	CALL	PUTHEX
	LD	A, (DBG_Z80_AFTER)
	CALL	PUTHEX
	LD	DE, MSG_CRLF
	CALL	PUTS

	; BIOS-Check: Z80-RAM muss 0x0000 sein (nicht 0xA55A!)
	LD	HL, (DBG_Z80_AFTER)
	LD	DE, 0
	OR	A
	SBC	HL, DE
	JP	Z, DET_CONFIRMED	; Z80-RAM = 0x0000 -> EM256 war aktiv!

	; Z80-RAM hat A55A oder anderes -> EM256 war nicht aktiv
	LD	DE, MSG_D_WARN
	CALL	PUTS
	SCF
	RET

DET_CONFIRMED:
	LD	DE, MSG_D_GOOD
	CALL	PUTS
	OR	A			; Carry loeschen = OK
	RET

; =============================================================================
; RAMON_S0 - EM256 Seite 0 in Z80-Fenster 0x4000 einblenden
;
; OUT (C), A mit B=0x4C, C=0xAF = Port 0x4CAF:
;   B[7:4]=4 -> 16*4-RAM Eintrag fuer Z80 A15:A12=0100 -> Fenster 0x4000
;   Datenbyte 0x0C: /P3=1(/A15=0), /P2=1(/A14=0), n_write=0, n_pagen=0
;   -> EM256-seitig Adressbits A15:A14=00 -> physische Seite 0 (0x0000-0x3FFF)
;
; PIO Port B = 0x10: reset16=1 (U8000 in Reset), n_ramen=0 (RAM aktiviert)
; Aendert: A, BC
; =============================================================================
RAMON_S0:
	LD	B, 04CH		; Port-High-Byte: Fenster 0x4000
	LD	C, RAM16	; Port-Low-Byte:  0xAF
	LD	A, 0CH		; Datenbyte: /P3=1, /P2=1, n_write=0, n_pagen=0
	OUT	(C), A		; 16*4-RAM: Fenster 0x4000 auf EM256 Seite 0 mappen
	LD	A, (1 SHL RESET16)	; 0x10: reset16=1, n_ramen=0 (aktiviert!)
	OUT	(PIOB), A
	RET

; =============================================================================
; LOAD_Z8000_CODE - Z8000-Maschinencode in den EM256-Speicher laden
;
; Laedt Z8K_CODE (laenge Z8K_CODE_LEN) nach Page 0 des EM256.
; Der Z8000 startet seinen Reset-Vektor von Adresse 0x0000 (= U8000-seitig
; Page 0). Der Reset-Vektor hat im Z8000-Format:
;   Word 0: FCW (Flag and Control Word, 0x0000 = Normal Sequential Mode)
;   Word 1: PC-Startadresse = 0x0004 (direkt hinter dem Vektor)
;
; Aufbau des in den RAM geladenen Codes:
;   0x0000: FCW  = 0x0000  (Normal Mode)
;   0x0002: PC   = 0x0004  (Code startet bei Byte 4)
;   0x0004: Additionsbefehl  ADD RR0, #0x5678 (0x1234 bereits in RR0 geladen)
;   ...     Ergebnis in [0x0010] ablegen und U8000 signalisieren (HALT/STOP)
;
; Aendert: A, BC, DE, HL
; =============================================================================
LOAD_Z8000_CODE:
	; Page 0, Segment 0 einblenden (schreiben)
	CALL	RAMON_S0

	; Z8000-Code per LDIR nach EM256ADR kopieren
	LD	HL, Z8K_CODE
	LD	DE, EM256ADR
	LD	BC, Z8K_CODE_LEN
	LDIR

	; Ergebniszellen vorher auf 0 setzen (Offset 0x10..0x11)
	XOR	A
	LD	(EM256ADR + 010H), A
	LD	(EM256ADR + 011H), A

	CALL	RAMOFF
	RET

; =============================================================================
; START_U8000 - U8000 aus dem Reset freigeben
;
; Setzt reset16=0, n_stop=1 (nicht gestoppt), n_ramen=1 (RAM fuer U880 aus).
; Der U8000 wird daraufhin seinen Reset-Vektor holen und Code ausfuehren.
;
; Aendert: A
; =============================================================================
START_U8000:
	; U8000 freigeben: reset16=0, n_stop=1, RAM fuer U880 deaktiviert
	LD	A, (1 SHL N_STOP) OR (1 SHL N_RAMEN)
	OUT	(PIOB), A
	RET

; =============================================================================
; WAIT_READY - Wartet bis U8000 Transfer Enable setzt oder Timeout
;
; Prueft PIO Port A Bit 7 (tren=1) oder Bit 4 (int16=1) als Fertigsignal.
; Timeout nach ca. TIMEOUT_HI * 256 Schleifendurchlaeufen.
;
; Rueckgabe: Carry clear = bereit, Carry set = Timeout
; Aendert:   A, BC
; =============================================================================
WAIT_READY:
	LD	B, TIMEOUT_HI
WAIT_OUTER:
	LD	C, 0		; Innerer Zaehler 256..1
WAIT_INNER:
	IN	A, (PIOA)	; PIO Port A lesen
	BIT	TREN, A		; Bit 7: Transfer Enable?
	JR	NZ, WAIT_OK	; Gesetzt -> U8000 ist fertig
	BIT	INT16, A	; Bit 4: Interrupt vom U8000?
	JR	NZ, WAIT_OK
	DEC	C
	JR	NZ, WAIT_INNER
	DJNZ	WAIT_OUTER
	; Timeout
	SCF
	RET
WAIT_OK:
	OR	A		; Carry loeschen
	RET

; =============================================================================
; STOP_U8000 - U8000 anhalten und in Reset versetzen
;
; Setzt reset16=1, n_ramen=1 (RAM aus). U8000 ist danach sicher inaktiv.
; Aendert: A
; =============================================================================
STOP_U8000:
	LD	A, (1 SHL RESET16) OR (1 SHL N_RAMEN)
	OUT	(PIOB), A
	RET

; =============================================================================
; READ_RESULT - Ergebnis aus Shared-RAM lesen
;
; Liest das Berechnungsergebnis des U8000:
;   - Low-Byte  aus EM256ADR + 0x10
;   - High-Byte aus EM256ADR + 0x11
; Ablage in RESULT_LO / RESULT_HI.
;
; Aendert: A, HL, (RESULT_LO), (RESULT_HI)
; =============================================================================
READ_RESULT:
	; Page 0, Segment 0 lesend einblenden
	CALL	RAMON_S0

	LD	A, (EM256ADR + 010H)
	LD	(RESULT_LO), A
	LD	A, (EM256ADR + 011H)
	LD	(RESULT_HI), A

	CALL	RAMOFF

	; Gelesene Werte auf Konsole ausgeben
	LD	DE, MSG_GOT
	CALL	PUTS
	LD	A, (RESULT_HI)
	CALL	PUTHEX
	LD	A, (RESULT_LO)
	CALL	PUTHEX
	LD	E, 0DH
	CALL	PUTC
	LD	E, 0AH
	CALL	PUTC
	RET

; =============================================================================
; CHECK_RESULT - Pruefroutine: stimmt Ergebnis mit Erwartungswert ueberein?
;
; Vergleicht RESULT_LO/RESULT_HI mit EXPECTED_LO/EXPECTED_HI.
;
; Rueckgabe: Carry clear = OK, Carry set = Fehler
; =============================================================================
CHECK_RESULT:
	LD	A, (RESULT_LO)
	CP	EXPECTED_LO
	JR	NZ, CHK_FAIL
	LD	A, (RESULT_HI)
	CP	EXPECTED_HI
	JR	NZ, CHK_FAIL
	OR	A		; Carry loeschen = OK
	RET
CHK_FAIL:
	SCF			; Carry setzen = Fehler
	RET

; =============================================================================
; RAMOFF - EM256-RAM wieder auskoppeln
;
; Aendert: A, BC
; =============================================================================
RAMOFF:
	; Gleiche Portadresse wie RAMON_S0 (B=0x4C, C=0xAF = Fenster 0x4000)
	; Datenbyte 0x0F: /P3=1, /P2=1 beibehalten, n_pagen=1, n_write=1 (sperren)
	LD	B, 04CH		; Port-High-Byte: gleiches Fenster 0x4000
	LD	C, RAM16	; C = 0xAF
	LD	A, 0CH OR (1 SHL N_PAGEN) OR (1 SHL N_WRITE)	; 0x0F
	OUT	(C), A		; Page sperren (n_pagen=1, n_write=1)
	; RAM deaktivieren (n_ramen=1), U8000 in Reset
	LD	A, (1 SHL RESET16) OR (1 SHL N_RAMEN)
	OUT	(PIOB), A
	RET

; =============================================================================
; PUTS - String ausgeben (DE = Adresse, '$'-terminiert, via BDOS Fn. 9)
; =============================================================================
PUTS:
	LD	C, PRINT
	CALL	BDOS
	RET

; =============================================================================
; PUTC - Einzelzeichen ausgeben (E = Zeichen, via BDOS Fn. 2)
; =============================================================================
PUTC:
	LD	C, CONOUT
	CALL	BDOS
	RET

; =============================================================================
; PUTHEX - Byte als 2-stellige Hex-Zahl ausgeben (A = Wert)
; =============================================================================
PUTHEX:
	PUSH	AF
	RRCA
	RRCA
	RRCA
	RRCA
	CALL	PUTHEXDIG
	POP	AF
	; Fallthrough: niederes Nibble ausgeben
PUTHEXDIG:
	AND	0FH
	CP	10
	JR	C, PUTHEX_NUM
	ADD	A, 'A' - 10
	JR	PUTHEX_OUT
PUTHEX_NUM:
	ADD	A, '0'
PUTHEX_OUT:
	LD	E, A
	JP	PUTC

; =============================================================================
; Z8000-Maschinencode
; -------------------
; Dieser Code wird auf dem U8000 ausgefuehrt.
;
; Z8000 Normal Sequential Mode Reset-Vektor (ab Adresse 0x0000):
;   Wort 0 (0x0000): FCW  = 0x0000  (Normal Mode, keine Interrupts)
;   Wort 1 (0x0002): PC   = 0x0008  (Code beginnt nach dem Deskriptor-Bereich)
;
; Ab 0x0008: Programmcode
;   LDRL  RR0, #0x00001234     ; 32-Bit-Wert laden (hohe 16 Bit in R0, niedere in R1)
;   ADDL  RR0, #0x00005678     ; 32-Bit-Addition (Ergebnis in RR0 = 0x000068AC)
;
; Alternativ nur 16-Bit:
;   LD    R1, #0x1234          ; R1 = 0x1234
;   ADD   R1, #0x5678          ; R1 = 0x68AC
;   LD    @R6, R1              ; R6 zeigt auf Ergebnisadresse im Shared-RAM
;
; Da der U8000 erst bei Adresse 0 startet und wir keinen vollstaendigen
; Z8000-Assembler haben, werden hier direkte Maschinencode-Bytes angegeben.
;
; Z8000-Befehlscodierung (Subset):
;   LD rn, #word    = 0x21 nn ii ii  (nn=Register 1-Byte, ii ii = Immediate 16bit MSB first)
;   ADD rn, #word   = 0x01 nn ii ii
;   LD @rPtr, rSrc  = 0x2F xx       (indirekt ueber Registerinhalt)
;   HALT            = 0x7A00
;
; R0..R15 = 16-Bit-Universalregister
; RR0=R0:R1, RR2=R2:R3, ... (32-Bit-Paare)
;
; Konkrete Codierung:
;   LD  R1, #0x1234   -> 21 01 12 34
;   LD  R2, #0x0010   -> 21 02 00 10   (R2 = Zieladresse 0x0010 fuer Ergebnis)
;   ADD R1, #0x5678   -> 01 01 56 78
;   LD  @R2, R1       -> 2F 21           (Mem[R2] = R1, d.h. Mem[0x0010] = 0x68AC)
;   HALT              -> 7A 00
;
; =============================================================================
Z8K_CODE:
	; Reset-Vektor (Z8000 Normal Sequential Mode, 4 Bytes):
	DB	000H, 000H	; FCW = 0x0000 (Normal Mode)
	DB	000H, 008H	; PC  = 0x0008 (Startadresse Code)
	DB	000H, 000H	; Padding (Bytes 4-5, nicht genutzt)
	DB	000H, 000H	; Padding (Bytes 6-7)

	; Programmcode ab Offset 0x0008:
	; LD R1, #0x1234
	DB	021H, 001H, 012H, 034H

	; LD R2, #0x0010  (Zieladresse im Shared-RAM: U8000-seitig Offset 0x0010 in Page 0)
	DB	021H, 002H, 000H, 010H

	; ADD R1, #0x5678
	DB	001H, 001H, 056H, 078H

	; LD @R2, R1  (Ergebnis [0x0010] = R1 = 0x68AC)
	DB	02FH, 021H

	; HALT (U8000 haelt an, setzt TREN implizit durch Busfreigabe)
	DB	07AH, 000H

Z8K_CODE_LEN	EQU	$ - Z8K_CODE

; =============================================================================
; Texte und Daten
; =============================================================================

MSG_BANNER:
	DB	0DH, 0AH
	DB	'EM256 U8000 Test  (c) 2026 Olaf Krieger', 0DH, 0AH
	DB	'----------------------------------------------', 0DH, 0AH, '$'

MSG_INIT:
	DB	'[1] PIO initialisieren...', 0DH, 0AH, '$'

MSG_DETECT:
	DB	'[2] EM256 suchen...', 0DH, 0AH, '$'

MSG_D1:
	DB	'  Z80-RAM vorher:    0x', '$'
MSG_D2:
	DB	'  EM256 vor Write:   0x', '$'
MSG_D3:
	DB	'  Ruecklesen:        0x', '$'
MSG_D4:
	DB	'  Z80-RAM nachher:   0x', '$'
MSG_PB_SELF:
	DB	'  PIO-B Selbsttest:  0x', '$'
MSG_PB_RAMON:
	DB	'  PIO-B nach RAMON:  0x', '$'
MSG_PB_RAMOFF:
	DB	'  PIO-B nach RAMOFF: 0x', '$'
MSG_PIOB:
	DB	'  PIO-B:             0x', '$'
MSG_CRLF:
	DB	0DH, 0AH, '$'
MSG_D_ERR1:
	DB	'  FEHLER: Schreiben/Lesen fehlgeschlagen (kein RAM?)', 0DH, 0AH, '$'
MSG_D_OK1:
	DB	'  OK: 0xA55A als Ruecklese korrekt.', 0DH, 0AH, '$'
MSG_D_RETRY:
	DB	'  (nicht genutzt)', 0DH, 0AH, '$'
MSG_D_WARN:
	DB	'  KEIN EM256: Z80-RAM nach RAMOFF != 0x0000!', 0DH, 0AH
	DB	'  Schreiben ging in Z80-RAM, nicht EM256.', 0DH, 0AH
	DB	'  Hinweis: PIO-B Selbsttest zeigt ob PIO funktioniert.', 0DH, 0AH
	DB	'  Erwartet: Selbsttest=0x94 RAMON=0x90 RAMOFF=0x94', 0DH, 0AH, '$'
MSG_D_GOOD:
	DB	'  BESTAETIGT: Z80-RAM=0x0000 -> EM256 war aktiv!', 0DH, 0AH, '$'

MSG_NOT_FOUND:
	DB	'    FEHLER: EM256 nicht gefunden!', 0DH, 0AH
	DB	'    Bitte sicherstellen, dass die 16-Bit-Karte installiert', 0DH, 0AH
	DB	'    und em256adr (0x4000) frei ist.', 0DH, 0AH, '$'

MSG_FOUND:
	DB	'    OK: EM256 gefunden.', 0DH, 0AH, '$'

MSG_LOAD:
	DB	'[3] Z8000-Code in Shared-RAM laden...', 0DH, 0AH
	DB	'    (0x1234 + 0x5678 = 0x68AC soll berechnet werden)', 0DH, 0AH, '$'

MSG_START:
	DB	'[4] U8000 starten (Reset aufheben)...', 0DH, 0AH, '$'

MSG_WAIT:
	DB	'[5] Warte auf Fertigmeldung des U8000 (TREN/INT16)...', 0DH, 0AH, '$'

MSG_TIMEOUT:
	DB	'    FEHLER: Timeout - U8000 hat nicht reagiert.', 0DH, 0AH
	DB	'    Moegliche Ursachen: Karte defekt, falscher Code, kein HALT.', 0DH, 0AH, '$'

MSG_READY:
	DB	'    OK: U8000 hat TREN oder INT16 gesetzt.', 0DH, 0AH, '$'

MSG_READ:
	DB	'[6] Ergebnis aus Shared-RAM lesen...', 0DH, 0AH
	DB	'    Gelesen (Big-Endian 16-Bit): 0x$'

MSG_GOT:
	DB	'    Gelesen: 0x$'

MSG_CHECK:
	DB	'[7] Pruefen Ergebnis (erwartet 0x68AC)...', 0DH, 0AH, '$'

MSG_FAIL:
	DB	'    FEHLER: Ergebnis stimmt nicht!', 0DH, 0AH, '$'

MSG_OK:
	DB	'    OK: U8000 hat korrekt 0x68AC berechnet!', 0DH, 0AH
	DB	'    Die 16-Bit-CPU funktioniert.', 0DH, 0AH, '$'

MSG_DONE:
	DB	'--- Test beendet ---', 0DH, 0AH, '$'

SAVED_SP:	DW	0
SAVE_WORD:	DW	0
DBG_TMP:	DW	0
DBG_PB0:	DB	0	; PIO-B nach Idle-Write (Selbsttest)
DBG_PB1:	DB	0	; PIO-B nach RAMON_S0
DBG_PB2:	DB	0	; PIO-B nach RAMOFF
DBG_EM_BEFORE:	DW	0	; EM256-Inhalt vor Muster-Write
DBG_READBACK:	DW	0	; Muster-Ruecklesen
DBG_Z80_AFTER:	DW	0	; Z80-RAM nach RAMOFF
RESULT_LO:	DB	0
RESULT_HI:	DB	0

; Stack (64 Bytes, waechst abwaerts)
	DS	64
STACK_TOP	EQU	$

	END	START
