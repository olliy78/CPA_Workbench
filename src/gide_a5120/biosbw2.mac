;BIOSCRT.MAC
;----------------------------------------------
;Grundlage original CP/A Quellen von 1989
;----------------------------------------------
;
;************************************************************
; Bildschirm-Ausgabe mit COLOR-BWS nach Heiko Poppe (old K7024)
;
; - Fehlerkorrektur Steuerzeichen 18h (es wurden nur 79 Zeichen gel.)
; - bei Tastenumdefinition auch chr(253) als Begrenzer (dbase)
; - BAB2 als Standardvariante
; - 17h (insline) und 19h (delline) eingefuehrt fuer TURBO-PASCAL-Editor
; - Realisierung der SCP1715-Steuerzeichen 1b 5e xx (Feldattribut)
;   und 1b 5f xx (Spezialzeichen)
;   Diese ESC-Folgen fueren beim Buerocomputer i.a. auf '^' (unzulaessig),
;   ausser Feldattribute invers und hell (Reaktion wie Steuerz. 84..87)
; - Einfuehrung Umlaut-Umkodierung fuer deutschen Zeichensatz
;   einschl. SCP1715-Steuerzeichen 0Eh und 0Fh
; - Einfuehrung MACROS "setbs" und "setram" zum Hin- und Rueckschalten
;   des Bildschirmpuffers
; 17.06.88
; - Zugriff zum Bildschirm aus Interruptroutinen unterdrueckt
; - Unterstuetzung von Karten mit Bit 7 invers (z.B. DSY5)
; - Unterst. einer weiteren Variante fuer dtsch. Zeichens. auf 00..1f (ZSIBM)
; 23.09.88
; - Einfuehrung der Macros 'crton' und 'crtoff'
; - di/ei waehrend Bildschirmumschaltung eingefuehrt
;************************************************************
;
; Aenderungen/Ergaenzungen:
;
; 13.10.2016 Klaus Wilfling
; Erweiterung fuer Heikos Color-BWS
; - Routine für die Ausgabe ueber die Farb-BWS-Karte vom Heiko erweitert
; - Routinen fuer Farbsetzten und Farbausgabe hinzugefuegt
; - Routine fuer Inverse/Intensivdarstellung geaendert
; - Routine fuer Sonderzeichen geaendert
;

 if1
; Warmstart-Initialisierung
;==========================
crtwarm	MACRO
;	
;### BWS ###################################################
;Farbbyte in Merkern speichern
;0 in color2=keine BWS gefunden
   				ld		a,(color2)
					ld		(color),a
					and		077h
					ld		(color1),a
;### BWS_END ###############################################
;
					xor		a
					ld		(desc),a	;evtl. ESCAPE-Modus beenden
 					ld		c,82h		  ;Kursor sichtbar machen
					call	crto
				ENDM
 endif	;if1

 IF crtbfl eq 0
; Bildschirm-Umschaltung
;=======================
; Achtung! kein Reg darf zerstoert werden!

; Bildschirmpuffer zuschalten 
crton:		di		;auf Grund der Hauptspeicher-Umschaltung keine Interrupts mgl
					ld		(bssbhl),hl
					pop		hl
					ld		(bssbrt),hl
					ld		(bsspsv),sp	;Hilfsstack, falls Stack im Umschaltbereich
					ld		sp,bsspst
					push	bc
					crton
					pop		bc
					ld		hl,0
bssbhl		equ	$-2
					jp		0
bssbrt		equ	$-2

; Bildschirmpuffer abschalten
crtoff:		ld		(bssrhl),hl
					pop		hl
					ld		(bssrrt),hl
					push	bc
					crtoff
					pop		bc
					ld		sp,0
bsspsv		equ	$-2
					ld		hl,0
bssrhl		equ	$-2
					ei
					jp		0
bssrrt		equ	$-2

					ds	2*5,0f8h	;kleines Hilfsstack waehrend Bildsch.umsch.
bsspst:
  IF1
; Aktivieren Bildschirmpuffer, kein Register darf zerstoert werden
setbs		MACRO
					push  hl
					push  de
					push  bc
					push  af
	  			call	crton
					pop   af
					pop   bc
					pop   de
					pop   hl
				ENDM
; Deaktivieren Bildschirmpuffer, kein Register darf zerstoert werden
setram	MACRO
					push  hl
					push  de
					push  bc
					push  af
					call	crtoff
					pop   af
					pop   bc
					pop   de
					pop   hl
				ENDM
  ENDIF
 ELSE ;crtbfl ne 0
  IF1
;; Bildschirm ist staendig adressierbar
setbs		MACRO
				ENDM
setram	MACRO
				ENDM
  ENDIF
 ENDIF

;**************************************************************************
crtst			equ		dumst				;CRT:-Status immer ready

crto:			ld		a,0c3h			;jp ...
					ld		(intcrt),a	;waehrend Bildaufbau Interrupt-Zugriff verb.
					push	bc					;merken zeichen in c
					ld		hl,(crtcps)	;Kursorposition	
					setbs
					res		7,(hl)			;loeschen Kursor
					setram
					call	crtoti			;Zeichen ausgeben
														;HL danach auf neuer Kursorpositon
; Setzen Kursor auf (HL)
					ld	  (crtcps),hl	;cursorposition
					setbs
					ld		a,80h
dcurs			equ	$-1
					or		(hl)				;Kursor setzen
					ld		(hl),a
					setram
crtonc:		pop		bc					;wiederherstellen c-reg
					ld		a,021h			;ld hl,...
					ld		(intcrt),a	;wiederzulassen Zugriff aus Interruptrtn

;
if (stpvar ne 0)  and (chdvar ne 0)
; Hardcopy realisieren
					ld	a,(lampbf)
					bit	lmphcp,a	;Hardcopy?
					ret	z		;nein
					ld	a,c
					and	7fh
					cp	20h		;Steuerzeichen?
					jr	c,crtoe1	;ja
					cp	7fh
					ret	c
crtoe1:		push	bc
					ld	hl,crtlc	;zugelassene Steuerzeichen
					ld	bc,crtlcl
					cpir			;erlaubt?
					pop	bc
					ret	z		;ja
					ld	c,'^'		;sonst Spezialzeichen
					ret

; bei Hardcopy Bildschirm -> Drucker zugelassene Steuerzeichen

crtlc:		db	08h,0ah,0ch,0dh
crtlcl		equ	$-crtlc

else
					ret
endif	;stpvar and chdvar

;
;========================================================
; interner Aufruf Bildschirmtreiber
; i HL	Zeiger in Bildschirmpuffer auf Kursorposition
; o HL	neuer Zeiger auf Kursorposition
;========================================================

crtoti:						
					ld		a,0					;escape mode
desc			equ		$-1
					or		a
					jp		nz,crto04		;ja

crto02:		ld		a,c
					ld		(crtcch),a	;merken fuer direkte Ausgabe
					cp		87h					;07h ist bell!, daher 87h<>07h
					jp		z,crto09
					res		7,a					;sonst 1xxxxxxxB  = 0xxxxxxxB
					cp		20h					;steuerzeichen?
					jp		c,crto09		;ja
					cp		7fh
					jp		nc,crto09
; 
IF umlaut
					call	crtuml			;evtl. Umlaute umkodieren
ENDIF

;
crtobs:
					ex		de,hl
crtsbl:

	setbs

;####### Invers Mono #####
        	ld  	hl,invmark
        	or  	(hl)
;#########################            	

     			push	af
        	ld    a,(color)
          and   077h
          jr    z,scright   ;keine Farbe, weiter
          
          in    a,(bwscr)   ;Farbspeicher ein
          set   0,a
          out   (bwscr),a
          ld    a,(color)  
          ld    (de),a      ;Farbe ausgeben
          in    a,(bwscr)   ;Zeichenspeicher ein
          res   0,a
          out   (bwscr),a 
scright:  pop   af

;#########################	
	
					ld		(de),a			;Zeichen in Bildspeicher ausgeben
	
	setram

crtcur:		ld		hl,0-bsend1
crtm01		equ	$-2
	      	add		hl,de				;bs voll?
	      	ex		de,hl
					inc		hl	
					ret		nc

;				
;BS voll ... scrollen				
;
					ld		de,bsend1-bssp1+1
crtm02		equ	$-2

crto03:		push	de

					ld		hl,bsanf1+bssp1	;aufschieben
crtm03		equ	$-2
					ld		de,bsanf1
crtm04		equ	$-2
					ld		bc,bsend1-bsanf1-bssp1+1
crtm05		equ	$-2
	
	setbs
	
;##########################
        
scrloop1: ld    a,(color)
    			and   077h
    			jr    z,scrxx1    ;keine Farbe, weiter 
    			
    			in    a,(bwscr)   ;Farbspeicher ein
          set   0,a
          out   (bwscr),a
    			ld    a,(hl)      ;Farbe von akt. Pos. holen
    			ld    (de),a      ;an neue Pos. speichern
    			in    a,(bwscr)   ;Zeichenspeicher ein
          res   0,a
          out   (bwscr),a 
scrxx1:		ld    a,(hl)      ;Zeichen von akt. Pos. holen
    			ld    (de),a      ;auf neue Pos. speichern
    			inc   hl
    			inc   de
    			dec   bc
    			ld    a,b
    			or    c
    			jr    nz,scrloop1
;    
;--- letzte Zeile loeschen ---
;			
					ld		de,bsend1-1 ;BWS Ende-1
crtm06		equ	$-2
					ld		bc,bssp1-1  ;Anzahl
crtm07		equ	$-2

;#######################################
										;+++ Korrektur wegen ldir Vermeidung
			    inc 	de	;+++++++++++++++++++
          inc 	bc 	;+++++++++++++++++++

scrloop2: ld    a,(color)   ;Farbbyte
    			and   077h
    			jr    z,scrxx2    ;keine Farbe, weiter 
          in    a,(bwscr)   ;Farbspeicher ein
          set   0,a
          out   (bwscr),a
          ld    a,(color) 
          ld    (de),a      ;Farbe an Cursorpos. ausgeben
          in    a,(bwscr)   ;Zeichenspeicher ein
          res   0,a
          out   (bwscr),a 
scrxx2:   ld    a,020h      ;Leerzeichen
          ld    (de),a      ;Leerz. an Cursorpos. ausgeben
          dec   de
          dec   bc
          ld    a,b
          or    c
          jr    nz,scrloop2  

;######################################
	
;				ldir
;				dec	hl
;				ld	(hl),' '	;letzte zeile loeschen
;				ld	de,bsend1-1
;crtm06	equ	$-2
;				ld	bc,bssp1-1
;crtm07	equ	$-2
;				lddr

	setram

					pop		hl 					; Cursor setzen
					ret

;------------------------------
; 84/04,..,86/06,87

IF (crt eq k7024) or (crt eq BWSHP)

;######################################
crto84:
;--- normale Darstellung (84h)
          ld    a,(color)
          and   077h
          jr    z,scioff     
          ld    a,(color1)       
          and   077h
          ld    (color),a
          ld    (color1),a
					ret								;konvexit

crto85:
;--- inverse Darstellung (85h)
          ld    a,(color)
          and   077h
          jr    z,scion    
          ld    a,(color1)       
          and   077h
          rrca
          rrca
          rrca
          rrca
          ld    (color),a
          ret								;konvexit
crto86:
;--- intensive Darstellung (86h)
          ld    a,(color)
          and   077h
          jr    z,scion    
					ld    a,(color1)
          and   077h
          or    08h
          ld    (color),a
          ret           		;konvexit
crto87:
;--- intensive und inverse Darstellung (87h)
          ld    a,(color)
          and   077h
          jr    z,scion    
					ld    a,(color1)       
          and   077h
          or    08h
          rrca
          rrca
          rrca
          rrca
          ld    (color),a
					ret								;konvexit

;#### Invers Mono ####
scion:	  ld	  a,80h		    ;---- INVERS -----
          jr	  scio		    ;Invers ein (bit 7)
scioff:   xor	  a	  	      ;Invers aus
scio:	    ld	  (invmark),a
;#####################	                 

; Ende Steuerzeichenroutinen fuer Bildschirm
; nichts ausgeben

konvexit:	ret	

konvexz:  ld		a,(crtcch)	;Zeichen direkt ausgeben
        	res		7,a					;ohne Bit 7
					jp 		crtsbl						 

konvex:   pop 	af         	;Register aufräumen
          ret
;###################################### 
 
;alt 
;crto84:
;crto85:
;crto86:
;crto87:
;	ld	a,(crtcch)	;Zeichen direkt ausgeben
;	res	7,a		;ohne Bit 7
;	jr	crtobs
 ENDIF
 
;--------------------------------

; Behandlung Sonderzeichen
;=========================
crto09:		ex		de,hl				;test sonderzeichen
					ld		hl,dszta
					ld		bc,dsztal
					cpir
					jr		z,crto11		;gefunden
					ld		c,'^'				;nicht-Sonderz. anzeigen
					ex		de,hl
			 	 	jp		crto02			;falls nicht gefunden

crto11:		ld		hl,dswe-1
					or		a
					sbc		hl,bc
					sbc		hl,bc
					ld		b,(hl)
					dec		hl
					ld		c,(hl)			;bc:=ansprungadresse
					push	bc
					ld		l,e
					ld		h,d					;bs adresse
					ld		a,' '				;fuer BS-loeschen
crtnop:		ret								;ansprung sonderzeichen
;
; Behandlung Zeichen innerhalb Escape-Folgen
;===========================================
;
crto04:

if	costu
					ld		b,0
cotd2			equ		$-1					;Restzeichenzahl Stringdef.
					djnz	crttd0			;nicht in Stringdefinition
					dec		a						;Escape-Rest := 1/0
					ld		(desc),a
					ld		a,c					;a:=Tastcode/Stringz.
					jr		z,cotd5			;im String
					push	hl					;retten Kursoradresse
					ld		hl,costrt
					cp		253					;Nutzerstringspeicher loeschen?
					jr		z,cotdcl		;ja
					or		a						;Nutzerstringspeicher loeschen?
					jr		nz,cotd1		;nein
cotdcl:		xor		a
					ld		(desc),a		;sonst Escape zuende
					dec		a
					inc		hl
					ld		(hl),a			;sonst Tabelle leeren
					pop		hl
					ret
cotd1:		call	costdf			;Tastencode in Nutzerstr.sp.
					pop		hl
					ret		pe					;ok
cotd4:		xor		a
					ld		(desc),a		;beenden Stringdef.
					jp		crtclk			;und Fehler anzeigen
cotd5:		cp		253					;Stringende?
					ret		z						;ja
					or		a						;Stringende?
					ret		z						;ja
					res		7,a
					push	hl
					call	costda			;Zeichen eintragen
					pop		hl
					jr		z,cotd4			;kein Platz mehr
					ld		a,1					;sonst naechstes Zeichen abw.
					ld		(desc),a
					ret
crttd0:		cp		2						;Zeichen nach ESC?
					jr		nz,crttd1		;nein
					ld		a,c
					cp		1bh					;Einleitung Stringdef.?
					ld		a,2
					jr		nz,crttd1		;nein
					dec		a						;Flag: in Stringdef.
					ld		(cotd2),a		;String-Def.-Flag setzen
					ret
crttd1:
endif ;costu
;
					dec		a
					ld		(desc),a		;naechstes escape flag setzen
;
IF escpc
					push 	af
					cp  	1
					ld		a,c					;1. Zeichen nach ESC mit offset nach A
			  	jr  	nz,escz2 
					ld  	(esc2cod),a
escz2:		pop 	af
	      	ld  	a,c		
ENDIF
;
					res		7,c					;loeschen evtl. offset 80h
	   			jr		z,crto07		;2. (letztes) Zeichen ESC-Folge

; vorletztes Zeichen ESC-Folge
;-----------------------------
 
IF escpc
					sub 	58h
					ret 	z			 			;1b 58	
					dec 	a
					ret 	z      			;1b 59
					dec 	a      
					ret 	z      			;1b 5a
					dec 	a 
					ret 	z      			;1b 5b
					dec	 	a
					ret 	z      			;1b 5c
					dec 	a
					ret 	z      			;1b 5d
					dec 	a
					ret 	z      			;1b 5e
					dec 	a
					ret 	z      			;1b 5f
ENDIF
;  
;Positionierung Zeile
;
					ld		a,bszl1-1		;letzte zeile
crtm08		equ	$-1
					cp		c						;nach letzter zeile?
					jr		c,crto05		;ja
					ld		a,c					;sonst auf gewuenschte zeile

crto05:		ld		hl,bsanf1		;zeile adressieren
crtm09		equ	$-2
					or		a
					ret		z
					ld		de,bssp1
crtm10		equ	$-2
					ld		b,a
crto06:		add		hl,de
					djnz	crto06			;zeile finden
					ret
;
; letztes Zeichen ESC-Folge
;--------------------------
crto07:

IF escpc
;#####################################################################
;PSEUDOGRAFIKZEICHEN 
;ESC+5Fh+(Zeichen)
;Ausgabe Grafikzeichen aus NANOS/AC1 ZG ( > 80h )
;
  				push 	af 					;2. Zeichen nach ESC merken (Grafikzeichen, Farbe, Spalte)
					
					ld 		a,(esc2cod) ;1. Zeichen nach ESC
konv5f:   cp    05fh        ;Grafikzeichen-Routine?
          jr    nz,konv58   ;NZ=nein
				  pop 	af
					jp    crtobs			;Pseudografikzeichen ausgeben
;
;FARBAUSGABEN (nur Color-BWS) sonst wird ignoriert
;--------------------------------------------------
;ESC+58h+(Standard-Zeichenfarbe+80h) nach Warmboot
;Einstellen der Zeichenfarbe nach Warmboot (color2)
;
konv58:	  cp		058h  			;ZF?
				 	jp    nz,konv59   ;NZ=nein
          pop   af					;Farbe	
          and   00001111b   ;ZF maskieren 
          ld    b,a					;ZF merken
          ld    a,(color2)  ;aktuelle Standard-Farbe
          and   11110000b   ;HF maskieren
          add   a,b         ;ZF+HF
          cp    00h
          jr    z,konv591   ;0 dann monochrom
          jr    konv592
;          
;ESC+5Bh+(Standard-Hintergrundfarbe+80h) nach Warmboot
;Einstellen der Hintergrundfarbe nach Warmboot (color2)
;
konv59:	  cp		059h  			;HF?
				 	jp    nz,konv5a   ;NZ=nein
         	pop   af 					;Farbe	  
          and   00001111b   ;HF maskieren
          rlca
          rlca
          rlca
          rlca
          ld    b,a					;HF merken
          ld    a,(color2)  ;aktuelle Standard-Farbe
          and   00001111b   ;ZF maskieren 
          add   a,b         ;ZF+HF
          cp    00h
          jr    z,konv591   ;0 dann monochrom
konv592:  ld    b,a         ;neue ZF+HF 
          rrca
          rrca
          rrca
          rrca
          cp    b           ;ZF und HF gleich?
          ret   z           ;konvexit  Z=Ja, dann ignorieren
          ld    a,b         ;neue Gesamtfarbe 
          ld    (color),a 
          ld    (color2),a  ;Farbe setzen
          and   077h        ;intensiv maskieren
          ld    (color1),a  ;Backup
          ret               ;konvexit
;         
konv591:  ld    (color2),a  ;Monochrom einschalten Farbe=0
          ld    a,bwshz 
          ld    (color),a   ;Farbe auf Standard setzen
          and   077h        ;intensiv maskieren
          ld    (color1),a  ;Backup
          jp    crtbsl      ;Bildschirm loeschen
;
;ESC+5Ah+(Zeichenfarbe+80h) im Betrieb
;Einstellen der aktuellen Zeichenfarbe (color, color1)
;
konv5a:  	cp    05Ah        ;ZF
          jp    nz,konv5b   ;NZ=nein
          ld    a,(color)   ;Color-BWS?
          and   a
          jp    z,konvex    ;Z=nein
          pop   af    			;Farbe
          and   077h				;intensiv maskieren
          and   00001111b   ;ZF maskieren 
          ld    b,a					;ZF merken
          ld    a,(color)   ;aktuelle Farbe
          and   11110000b   ;HF maskieren
          jr    konv5b2
;
;ESC+5Bh+(Hintergrundfarbe+80h) im Betrieb
;Einstellen der aktuellen Hintergrundfarbe (color, color1)
;
konv5b:  	cp    05Bh        ;HF?
          jp    nz,konv5d   ;NZ=nein
          ld    a,(color)   ;Color-BWS?
          and   a
          jp    z,konvex    ;Z=nein
        	pop   af   				;Farbe
          and   077h				;intensiv maskieren
          and   00001111b   ;HF maskieren
          rlca
          rlca
          rlca
          rlca
          ld    b,a				  ;HF merken
          ld    a,(color)   ;aktuelle Farbe
          and   00001111b   ;ZF maskieren 
konv5b2:  add   a,b         ;ZF+HF
          cp    00h
          jr    z,konv591   ;0 dann monochrom
          ld    b,a         ;neue ZF+HF 
          rrca
          rrca
          rrca
          rrca
          cp    b           ;ZF und HF gleich?
          ret   z           ;konvexit  Z=Ja, dann ignorieren
          ld    a,b         ;neue Gesamtfarbe 
          ld    (color),a   ;HF setzen
          and   077h        ;intensiv maskieren
          ld    (color1),a  ;Backup
          ret								;konvexit
           
;
;alte Routine aus Kompatibilitaetsgruenden fue Nutzung des FC u.a.
;ESC+5Dh+(Farbe)
;Einstellen der aktuellen Farben im Betrieb          
           
konv5d:		cp 		05dh
					jr 		nz,spalte
          ld    a,(color)   ;Color-BWS?
          and   a
          jp    z,konvex    ;Z=nein
          pop   af					;Farbe   
          and   077h        ;intensiv maskieren
          ld    b,a
          rrca
          rrca
          rrca
          rrca
          cp    b           ;Zeichen- und HG-Farbe gleich?
          ret   z           ;konvexit  Z=Ja, dann ignorieren
          ld    a,b
          ld    (color),a   ;Farbe setzen
          and   077h        ;intensiv maskieren
          ld    (color1),a  ;Backup
          ret               ;konvexit
           
spalte:		pop 	af					;Spalte

;#############################################################################
;
;ld	b,0ffh
;crtffl	equ	$-1		;auf 00 bei "1b 5e xx"; auf 01 bei "1b 5f xx"
;	djnz	crtnsp		;nicht 1b 5f xx

;crtfa3:	ld	a,'^'		;Spezialzeichen nicht realisierbar

;	jp	 crtobs

;crtnsp:
; 	inc	b		;1b 5e xx?
;	jr	nz,crtnfa	;nein
;	bit	4,a		;invers?
;	jr	z,crtfa1	;nein
;	set	0,b
;crtfa1:	bit	0,a		;hell?
;	jr	z,crtfa2	;nein
;	set	1,b
;crtfa2:	and	00101110b	;wurden noch andere Funktionen verlangt?
;	jr	nz,crtfa3	;ja, kann die Hardware nicht
;	ld	a,84h
;	or	b		;Steuerzeichen auf 84..87 abbilden
